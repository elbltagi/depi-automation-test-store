<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Full suite. The Extent report listener is NOT declared here: it is registered
  via META-INF/services/org.testng.ITestNGListener so that IDE runs get the
  report too. Declaring it in both places would double every entry.

  Run: mvn test -Dsurefire.suiteXmlFiles=testng.xml
-->
<suite name="Toolshop UI Suite" verbose="1">

    <test name="Auth">
        <classes>
            <class name="Toolshop.Auth.Login"/>
            <class name="Toolshop.Auth.Rigster"/>
        </classes>
    </test>

    <test name="Catalog">
        <classes>
            <class name="Toolshop.catalog.filters"/>
        </classes>
    </test>

    <test name="Product">
        <classes>
            <class name="Toolshop.product.ProductDetails"/>
            <class name="Toolshop.product.QuantitySelector"/>
        </classes>
    </test>

    <test name="Checkout">
        <classes>
            <class name="Toolshop.Checkout.CartTests"/>
            <class name="Toolshop.Checkout.SignInTests"/>
            <class name="Toolshop.Checkout.BillingAddress"/>
            <class name="Toolshop.Checkout.PaymentTests"/>
        </classes>
    </test>

    <test name="End to end">
        <classes>
            <class name="Toolshop.end.end_to_end"/>
        </classes>
    </test>

</suite>
